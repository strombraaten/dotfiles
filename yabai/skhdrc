# ================================================================
# YABAI HOTKEYS
# ================================================================
# Hyper = Cmd + Ctrl + Option (for focusing/viewing)
# Meh   = Shift + Ctrl + Option (for moving/manipulating)
# ================================================================

# ----------------------------------------------------------------
# HYPER KEY - FOCUSING & VIEWING OPERATIONS
# ----------------------------------------------------------------

# Focus Window (Hyper + OINE - Colemak directions)
cmd + ctrl + alt - o : yabai -m window --focus east
cmd + ctrl + alt - e : yabai -m window --focus north
cmd + ctrl + alt - i : yabai -m window --focus south
cmd + ctrl + alt - n : yabai -m window --focus west

# Balance Space (Hyper + Space)
cmd + ctrl + alt - space : yabai -m space --balance

# Rotate Space (Hyper + .)
cmd + ctrl + alt - 0x2F : yabai -m space --rotate 270

# Layout Changes (Hyper + Layout keys)
cmd + ctrl + alt - 0x2C : yabai -m space --layout bsp          # Hyper + /
cmd + ctrl + alt - 0x2B : yabai -m space --layout stack        # Hyper + ,

# Restart Yabai (Hyper + Y)
cmd + ctrl + alt - y : yabai --restart-service

# Resize Window (Hyper + - / =)
cmd + ctrl + alt - 0x1B : yabai -m window --ratio rel:-0.05   # Hyper + - (smaller)
cmd + ctrl + alt - 0x18 : yabai -m window --ratio rel:+0.05   # Hyper + = (larger)

# ----------------------------------------------------------------
# MEH KEY - MOVING/MANIPULATING OPERATIONS
# ----------------------------------------------------------------

# Move Window to Space (Meh + Number)
shift + ctrl + alt - 1 : yabai -m window --space 1
shift + ctrl + alt - 2 : yabai -m window --space 2
shift + ctrl + alt - 3 : yabai -m window --space 3
shift + ctrl + alt - 4 : yabai -m window --space 4
shift + ctrl + alt - 5 : yabai -m window --space 5
shift + ctrl + alt - 6 : yabai -m window --space 6

# Swap Window (Meh + OINE)
shift + ctrl + alt - o : yabai -m window --swap east
shift + ctrl + alt - e : yabai -m window --swap north
shift + ctrl + alt - i : yabai -m window --swap south
shift + ctrl + alt - n : yabai -m window --swap west

# Warp Window (Meh + Cmd + OINE)
shift + ctrl + alt + cmd - o : yabai -m window --warp east
shift + ctrl + alt + cmd - e : yabai -m window --warp north
shift + ctrl + alt + cmd - i : yabai -m window --warp south
shift + ctrl + alt + cmd - n : yabai -m window --warp west

# Space Operations (Meh + Symbols)
shift + ctrl + alt - 0x1E : yabai -m space --mirror x-axis     # Meh + ]
shift + ctrl + alt - 0x27 : yabai -m space --mirror y-axis     # Meh + '

# Layout Float (Meh + /)
shift + ctrl + alt - 0x2C : yabai -m space --layout float      # Meh + /

# Window Resize (Hyper + Q/W)
cmd + ctrl + alt - q : yabai -m window --ratio rel:+0.1        # Hyper + Q (larger)
cmd + ctrl + alt - w : yabai -m window --ratio rel:-0.1       # Hyper + W (smaller)
